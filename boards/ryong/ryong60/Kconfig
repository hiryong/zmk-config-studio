config BOARD_ENABLE_DCDC
    bool "Enable DCDC mode"
    select SOC_DCDC_NRF52X
    default y
    depends on BOARD_RYONG60

config RYONG_WAKE_POSITION
    int "Key position of the wake key (set on key.ryong.com; must match ryong-wake.dtsi)"
    default 60
    depends on BOARD_RYONG60
