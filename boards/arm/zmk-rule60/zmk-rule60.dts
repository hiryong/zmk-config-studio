/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>

#include <dt-bindings/led/led.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "zmk-rule60-pinctrl.dtsi"
#include <layouts/common/60percent/ansi.dtsi>




/ {
    model = "zmk_rule60";
    compatible = "zmk_rule60";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        // zmk,battery = &vbatt;
        zmk,battery = &builtin_fuel_gauge;
        zmk,kscan = &kscan0;
        // zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &layout_60_ansi;
        zmk,underglow = &led_strip;
        zmk,backlight = &backlight;   // ryong60: 키별 흰색 백라이트 (P0.03 PWM → AO3400)
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
                RC(2,0)         RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)          RC(3,13)
                RC(4,0) RC(4,1) RC(4,2)                         RC(4,6)                         RC(4,10) RC(4,11) RC(4,12) RC(4,13)  
        >;
    };

    // ryong60: 전원 끄기(soft off) 뒤에는 Space 키 하나만 칩을 깨움 (ZMK 'Wakeup-only Key Switch' 방식).
    //   ROW4(P0.22)를 켜 둔 채 COL6(P1.11)을 감시 → ROW4×COL6 = Space 만 반응, 다른 키는 무시.
    //   깨어난 뒤에는 ryong60_power.c 가 Fn+Space 를 3초 누르고 있는지 확인하고, 아니면 다시 끔.
    //   (15분 무입력 자동 절전은 이와 별개로 아무 키나 누르면 깨어남)
    wake_keys {
      compatible = "gpio-keys";
      space_wake_key: space_wake_key {
        gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
      };
    };

    space_wakeup: space_wakeup {
      compatible = "zmk,gpio-key-wakeup-trigger";
      trigger = <&space_wake_key>;
      wakeup-source;
      extra-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
    };

    soft_off_wakers {
      compatible = "zmk,soft-off-wakeup-sources";
      wakeup-sources = <&space_wakeup>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "row2col";
        col-gpios
            = <&gpio0  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        row-gpios
            = <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            ;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        };
    };

    // Node name must match original "EXT_POWER" label to preserve user settings.
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
    };

    // ryong60: 키별 백라이트. P0.03 → AO3400 N-MOS (low-side), 61개 흰색 LED
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_USEC(125) PWM_POLARITY_NORMAL>;   // 8kHz: 가장 어두운 밝기에서도 잔상 없음, P0.03(저주파 전용 핀) 권장 10kHz 이하
        };
    };

    vbatt: vbatt {
      compatible = "zmk,battery-nrf-vddh";
    };    
};

&layout_60_ansi {
  transform = <&default_transform>;
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&spi3 {
    compatible = "nordic,nrf-spim";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    status = "okay";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <14>; /* LED strip length */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&i2c1 {
  status = "okay";
  compatible = "nordic,nrf-twi";
  pinctrl-0 = <&i2c1_default>;
  pinctrl-1 = <&i2c1_sleep>;
  pinctrl-names = "default", "sleep";

  builtin_fuel_gauge: max17048@36 {
      compatible = "zmk,maxim-max17048";
      status = "okay";
      reg = <0x36>;
  };
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    /*
    * For more information, see:
    * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
    */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        /*
        * The flash starting at 0x000d4000 and ending at
        * 0x000f3fff is reserved for use by the application.
        */

        /*
        * Storage partition will be used by FCB/LittleFS/NVS
        * if enabled.
        */
        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
 
