CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_ZMK_RULE60=y

# CONFIG_ZMK_SETTINGS_RESET_ON_START=y

CONFIG_ZMK_PM_SOFT_OFF=y
CONFIG_ZMK_IDLE_TIMEOUT=30000           
# ryong60: 아래 RGB 언더글로우 사용 안 함 → RGB 전원 스위치(Q2)는 하드웨어 기본값(꺼짐) 유지
#   다시 쓰려면: 이 줄과 CONFIG_ZMK_RGB_UNDERGLOW 를 =y 로, 그 아래 # 붙은 RGB 줄들의 # 을 지우고, 키맵에 &rgb_ug RGB_TOG 키 추가
CONFIG_ZMK_EXT_POWER=n
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000


# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# CONFIG_WS2812_STRIP=y

CONFIG_ZMK_RGB_UNDERGLOW=n
# CONFIG_ZMK_RGB_UNDERGLOW_HUE_START=160
# CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=3
# CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=y
# CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n

CONFIG_ZMK_POINTING=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

CONFIG_I2C=y
CONFIG_ZMK_MAX17048=y

# ---- ryong60 추가 ----
CONFIG_ZMK_KEYBOARD_NAME="ryong60"

# 키별 백라이트 (P0.03 PWM)
CONFIG_PWM=y
CONFIG_LED=y
CONFIG_LED_PWM=y
CONFIG_ZMK_BACKLIGHT=y
CONFIG_ZMK_BACKLIGHT_ON_START=n
CONFIG_ZMK_BACKLIGHT_BRT_START=40
CONFIG_ZMK_BACKLIGHT_BRT_STEP=20
CONFIG_ZMK_BACKLIGHT_AUTO_OFF_IDLE=y

# ZMK Studio (브라우저에서 키 실시간 변경). 빌드 때 -S studio-rpc-usb-uart 를 함께 줘야 함
CONFIG_ZMK_STUDIO=y
