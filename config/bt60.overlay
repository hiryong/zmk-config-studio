/*
 * Soft-off wake: only the Fn key (bottom right, matrix RC(5,13)) wakes the keyboard.
 * Matrix is col2row: column 13 = P0.12 (driven high before off),
 * row 5 = P1.04 (input, pull-down).
 * After waking, src/bt60_power_confirm.c asks for Fn + the Soft Off key held 3 s.
 * The matrix keeps its normal wakeup-source so 15 min idle sleep still wakes on
 * any key; ZMK turns that off by itself when entering soft-off.
 */

/ {
    wake_keys {
        compatible = "gpio-keys";
        fn_wake_key: fn_wake_key {
            gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
    };

    fn_waker: fn_waker {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&fn_wake_key>;
        wakeup-source;
        extra-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&fn_waker>;
    };
};
